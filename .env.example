# Copy to `.env` and edit locally. Never commit `.env`.

# ── Backend ─────────────────────────────────────────────
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO

# SQLite for MVP; swap for a PostgreSQL DSN later.
DATABASE_URL=sqlite:///./data/app.db

# Redis for the job queue (docker compose brings this up).
REDIS_URL=redis://127.0.0.1:6379/0

# ── Storage ─────────────────────────────────────────────
STORAGE_ROOT=./storage
MAX_UPLOAD_MB=200

# ── Adapters ────────────────────────────────────────────
# Which concrete engine each abstract adapter should use.
# See models/*/base.py for the interfaces.
LLM_ENGINE=ollama                 # ollama | openai_compat | stub
LLM_MODEL=qwen2.5:3b-instruct
LLM_BASE_URL=http://127.0.0.1:11434

IMAGE_ENGINE=placeholder          # placeholder | openvino_sdxl | diffusers_cpu
IMAGE_MODEL=stabilityai/sdxl-turbo

VIDEO_ENGINE=procedural           # procedural | wan | svd
VIDEO_MODEL=

LIPSYNC_ENGINE=noop               # noop | wav2lip | musetalk
LIPSYNC_MODEL=

TTS_ENGINE=piper                  # piper | indicf5 | stub
TTS_MODEL=

# ── Whisper / ASR ───────────────────────────────────────
WHISPER_MODEL=small               # tiny | base | small | medium | large-v3
WHISPER_COMPUTE_TYPE=int8         # int8 | int8_float16 | float16 | float32
WHISPER_DEVICE=cpu                # cpu | cuda | auto

# ── Frontend ────────────────────────────────────────────
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
